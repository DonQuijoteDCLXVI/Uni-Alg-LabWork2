<Window x:Class="FractalViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FractalViewer"
        Title="Recursive Fractal Visualizer"
        Width="1100" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Swatch + name, shared by all three color drop-downs -->
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="16" Height="16" Margin="0,0,8,0"
                           Stroke="Gray" StrokeThickness="0.5" Fill="{Binding Brush}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────── Control panel ───────── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#F2F2F2">
            <StackPanel Margin="16">
                <TextBlock Text="Fractal Visualizer" FontSize="20" FontWeight="Bold" />

                <TextBlock Style="{StaticResource Label}" Text="Fractal type" />
                <ComboBox x:Name="TypeBox" SelectedIndex="0" SelectionChanged="OnTypeChanged">
                    <ComboBoxItem Tag="Tree">Fractal Tree</ComboBoxItem>
                    <ComboBoxItem Tag="Sierpinski">Sierpinski Triangle</ComboBoxItem>
                    <ComboBoxItem Tag="Koch">Koch Snowflake</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="DepthLabel" Style="{StaticResource Label}" />
                <Slider x:Name="DepthSlider" Minimum="0" Maximum="14" Value="10"
                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        ValueChanged="OnSettingChanged" />
                <TextBlock x:Name="StatsText" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0" />

                <!-- Only visible for the tree -->
                <StackPanel x:Name="TreeOptions">
                    <TextBlock x:Name="AngleLabel" Style="{StaticResource Label}" />
                    <Slider x:Name="AngleSlider" Minimum="5" Maximum="60" Value="25"
                            ValueChanged="OnSettingChanged" />

                    <TextBlock x:Name="RatioLabel" Style="{StaticResource Label}" />
                    <Slider x:Name="RatioSlider" Minimum="0.55" Maximum="0.85" Value="0.75"
                            ValueChanged="OnSettingChanged" />
                </StackPanel>

                <TextBlock Style="{StaticResource Label}" Text="Start color (depth 0 / first shape)" />
                <ComboBox x:Name="StartColorBox" ItemTemplate="{StaticResource ColorItemTemplate}"
                          SelectionChanged="OnColorChanged" />

                <TextBlock Style="{StaticResource Label}" Text="End color (deepest level / last shape)" />
                <ComboBox x:Name="EndColorBox" ItemTemplate="{StaticResource ColorItemTemplate}"
                          SelectionChanged="OnColorChanged" />

                <TextBlock Style="{StaticResource Label}" Text="Background" />
                <ComboBox x:Name="BackgroundBox" ItemTemplate="{StaticResource ColorItemTemplate}"
                          SelectionChanged="OnColorChanged" />

                <Button Content="Export PNG…" Margin="0,24,0,0" Padding="8,6" Click="OnExportClick" />
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── Drawing surface ───────── -->
        <local:FractalCanvas x:Name="FractalView" Grid.Column="1" />
    </Grid>
</Window>
